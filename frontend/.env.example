# ──────────────────────────────────────────────────────────────
# UFNS Frontend — Environment Variables
# Copy this file to .env.local for local overrides.
# ──────────────────────────────────────────────────────────────

# Backend URL (without trailing slash, without /api)
# Leave blank for local dev (Vite proxy handles it automatically).
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# when deploying the frontend separately from the backend.
#
# Example:
#   VITE_API_URL=https://ufns-backend.railway.app
#
VITE_API_URL=
